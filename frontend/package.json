{
  "name": "adventure-planner-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens": "style-dictionary build --config style-dictionary.config.js",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "vitest run src/test/a11y.axe.test.tsx",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prestorybook": "npm run tokens",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run tokens",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "@vanilla-extract/css": "^1.21.0",
    "lucide-react": "^1.23.0",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-aria-components": "^1.19.0",
    "react-dom": "^18.3.1",
    "react-map-gl": "^8.1.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^27.4.0",
    "storybook": "^10.4.6",
    "style-dictionary": "^4.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^3.2.6"
  }
}
