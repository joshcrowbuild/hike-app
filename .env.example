# Adventure Planner — environment template.
# Copy to `.env` (git-ignored) and fill in. NEVER commit real values.
# This file documents the shape only; secrets live in a real store.

# ── LLM orchestration ────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Graph (local Neo4j Community for dev) ────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Live-data sources (Stage 1 catalog; most are free/keyless) ─
# NWS api.weather.gov — keyless (requires a User-Agent contact string)
NWS_USER_AGENT=
# EPA AirNow — API key required
AIRNOW_API_KEY=
# NASA FIRMS — MAP_KEY required
FIRMS_MAP_KEY=
# Recreation.gov RIDB — API key required
RIDB_API_KEY=
# USGS Water Services — keyless

# ── Watch / personal (Phase 1+, not Phase 0) ─────────────────
# Garmin login is sensitive — community lib only; keep swappable.
GARMIN_EMAIL=
GARMIN_PASSWORD=
