# Adventure Planner — environment template.
# Copy to `.env` (git-ignored) and fill in. NEVER commit real values.
# This file documents the shape only; secrets live in a real store.

# ── Model providers (provider-agnostic, local-first — Decision Log §29) ──
# Default backend: a local OpenAI-compatible server (Ollama / vLLM / LM Studio).
LOCAL_OPENAI_BASE_URL=http://localhost:11434/v1
# Per-tier provider ("local" | "anthropic") + model id; local-first defaults.
# "local_model" is what sensitivity routing falls back to when a private-overlay
# prompt forces on-device inference even though the tier defaults to cloud.
ADVENTURE_PROVIDER_MECHANICAL=local
ADVENTURE_MODEL_MECHANICAL=
ADVENTURE_LOCAL_MODEL_MECHANICAL=
ADVENTURE_PROVIDER_JUDGMENT=local
ADVENTURE_MODEL_JUDGMENT=
ADVENTURE_LOCAL_MODEL_JUDGMENT=
# Cloud yardstick (hot-swap; never used for private-overlay prompts).
ANTHROPIC_API_KEY=

# ── Graph (local Neo4j Community for dev) ────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Required by docker-compose (compose refuses to start without it).
NEO4J_PASSWORD=

# ── Geographic scope (Stage 3: polygon-bounded region) ───────
ADVENTURE_REGION=shenandoah-gwj

# ── Live-data sources (Stage 1 catalog; most are free/keyless) ─
# NWS api.weather.gov — keyless (requires a User-Agent contact string)
NWS_USER_AGENT=
# EPA AirNow — API key required
AIRNOW_API_KEY=
# NASA FIRMS — MAP_KEY required
FIRMS_MAP_KEY=
# Recreation.gov RIDB — API key required
RIDB_API_KEY=
# USGS Water Services — keyless

# ── Watch / device-integration seam (Epic 004; Phase 1+) ─────
# Enabled device adapters (comma-separated). Empty = no devices, pipeline runs.
# Each named adapter pulls its own secrets below. Unknown name → ValueError.
ADVENTURE_WATCH_ADAPTERS=
# Garmin login is sensitive — community lib (garth/garminconnect) only; swappable.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Coros — official OAuth2 (open.coros.com) for batch ingestion (MCP is interactive only).
COROS_CLIENT_ID=
COROS_CLIENT_SECRET=
