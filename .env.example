# Adventure Planner — environment template.
# Copy to `.env` (git-ignored) and fill in. NEVER commit real values.
# This file documents the shape only; secrets live in a real store.

# ── Model providers (provider-agnostic, local-first — Decision Log §29) ──
# Default backend: a local OpenAI-compatible server (Ollama / vLLM / LM Studio).
LOCAL_OPENAI_BASE_URL=http://localhost:11434/v1
# Per-tier provider ("local" | "anthropic") + model id; local-first defaults.
# "local_model" is what sensitivity routing falls back to when a private-overlay
# prompt forces on-device inference even though the tier defaults to cloud.
ADVENTURE_PROVIDER_MECHANICAL=local
ADVENTURE_MODEL_MECHANICAL=
ADVENTURE_LOCAL_MODEL_MECHANICAL=
ADVENTURE_PROVIDER_JUDGMENT=local
ADVENTURE_MODEL_JUDGMENT=
ADVENTURE_LOCAL_MODEL_JUDGMENT=
# Cloud yardstick (hot-swap; never used for private-overlay prompts).
ANTHROPIC_API_KEY=

# ── Graph (local Neo4j Community for dev) ────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Required by docker-compose (compose refuses to start without it).
NEO4J_PASSWORD=

# ── Geographic scope (Stage 3: polygon-bounded region) ───────
ADVENTURE_REGION=shenandoah-gwj

# ── Edge auth (Epic 014) ─────────────────────────────────────
# Until the Stage-8 auth system exists, a non-anonymous viewer_id at the API edge
# must present this shared secret via the X-Dev-Viewer-Secret header. Absent by
# default → only the open anonymous world works; a forged identity fails closed.
ADVENTURE_DEV_VIEWER_SECRET=
# ── Hosted API edge — CORS (deploy only; docs/runbooks/deploy-api-render.md) ──
# Comma-separated EXACT browser origins allowed to call the API cross-origin.
# Empty = default-deny (no origin allowed; never a wildcard). The hosted API needs
# the Vercel frontend's origin, e.g.: https://hike-app.vercel.app
ADVENTURE_CORS_ALLOW_ORIGINS=
# ── Corpus-source seam (Epic 012) ────────────────────────────
# Enabled corpus sources (comma-separated, order = config order). Absent →
# defaults to all four sources below (osm,nps,usfs,usgs-3dep). Unknown name →
# ValueError. The one source declaring role=spine (OSM) is conflated against
# the others.
ADVENTURE_CORPUS_SOURCES=osm,nps,usfs,usgs-3dep
# USFS ingests from a local bulk GeoJSON (EDW REST 403s from non-USFS IPs).
# Leave this UNSET (commented out) to use the adapter's default path
# (data/usfs/trails.geojson); a missing file then degrades to [] at runtime.
# Only set it to a real path — a blank/whitespace value is a misconfiguration
# that fails loud (ValueError), aborting the whole run.
# ADVENTURE_USFS_GEOJSON=/abs/path/to/usfs/trails.geojson
# USGS-3DEP elevation enrichment (Epic 017) — the first enrichment source, a
# default corpus source (so a re-ingest never forgets to re-apply elevation).
# A DEM raster is per-region — point ADVENTURE_3DEP_DEM at a local 3DEP DEM
# raster (1/3 arc-sec ≈ 10 m) covering the region you're ingesting. Absent →
# gracefully skips elevation enrichment for this run (log + continue; existing
# elevation, if any, is left untouched — never a wipe, never a hard error).
# ADVENTURE_3DEP_RESOLUTION_M sets the along-route sampling spacing in metres
# (default 20). As of this writing only shenandoah-gwj has a DEM downloaded;
# Richmond/OBX need theirs downloaded before they'll carry elevation data.
# ADVENTURE_3DEP_DEM=/abs/path/to/3dep/dem.tif
# ADVENTURE_3DEP_RESOLUTION_M=20

# ── Live-data sources (Stage 1 catalog; most are free/keyless) ─
# NWS api.weather.gov — keyless (requires a User-Agent contact string)
NWS_USER_AGENT=
# EPA AirNow — API key required
AIRNOW_API_KEY=
# NASA FIRMS — MAP_KEY required
FIRMS_MAP_KEY=
# Recreation.gov RIDB — API key required
RIDB_API_KEY=
# USGS Water Services — keyless

# ── LiveAdapter seam (Epic 013) ──────────────────────────────
# Enabled live adapters (comma-separated). Position sets primary vs. fallback within
# a ConditionKind. Empty = no live probes (the engine still runs — source-or-silence).
# Unknown name → ValueError. Known: nws, airnow, firms, usgs_water, ridb, valhalla, echo.
ADVENTURE_LIVE_ADAPTERS=
# Country/coverage code adapters are gated on (distinct from ADVENTURE_REGION, the
# ingest polygon). A US-only feed isn't selected outside this region. Default: US.
ADVENTURE_LIVE_REGION=US
# Self-hosted Valhalla base URL for drive-time (Epic 005, folded into Epic 013).
# Absent → no drive-time line, no pruning (parity with the missing-key probe pattern).
VALHALLA_BASE_URL=
# Road-speed assumption (km/h) converting a radius to a drive-time budget. Default 60.
DRIVE_SPEED_KMH=60.0
# ── Commons fork (Epic 010) ──────────────────────────────────
# Secret salt for the one-way writer_hash (HMAC) keying revocation lookups.
# Must be a high-entropy random string; never commit a real value (#10).
# Absent → the de-identified commons fork is skipped (episode ingest still runs).
ADVENTURE_COMMONS_WRITER_SALT=

# ── Watch / device-integration seam (Epic 004; Phase 1+) ─────
# Enabled device adapters (comma-separated). Empty = no devices, pipeline runs.
# Each named adapter pulls its own secrets below. Unknown name → ValueError.
ADVENTURE_WATCH_ADAPTERS=
# Garmin login is sensitive — community lib (garth/garminconnect) only; swappable.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Coros — official OAuth2 (open.coros.com) for batch ingestion (MCP is interactive only).
COROS_CLIENT_ID=
COROS_CLIENT_SECRET=
